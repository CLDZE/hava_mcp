# Hava API token (Personal Settings -> API Tokens -> Display Token).
# This is the primary auth path; it wins over any stored credential.
HAVA_API_TOKEN=

# Optional: self-hosted Hava API base URL. Defaults to https://api.hava.io
# HAVA_ENDPOINT=https://hava.internal.example.com

# Optional: force the file credential store instead of the OS keychain.
# HAVA_MCP_CREDENTIAL_STORE=file
